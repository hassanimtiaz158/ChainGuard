# ChainGuard environment configuration.
#
# SAFETY: RPC_URL is an internal service address, NOT a user-supplied setting.
# The API refuses to start unless the chain reports EXPECTED_CHAIN_ID (31337).
# Never point these values at mainnet or a public testnet.

# Local lab chain (internal Docker network only -- Anvil publishes no host ports)
RPC_URL=http://anvil:8545
EXPECTED_CHAIN_ID=31337

# Datastores (internal only)
DATABASE_URL=postgresql+psycopg://chainguard:chainguard@postgres:5432/chainguard
REDIS_URL=redis://redis:6379/0

# Content
SCENARIOS_DIR=/app/scenarios
EXPLANATIONS_DIR=/app/explanations
LAB_STATE_DIR=/app/lab
CONTRACTS_OUT_DIR=/app/contracts/out

# Analyzer sandbox
ANALYZER_SOCKET=/run/chainguard/analyzer.sock
ANALYSIS_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=204800

# API
API_LOG_LEVEL=INFO
RUN_RATE_LIMIT_PER_MINUTE=20
ANALYSIS_RATE_LIMIT_PER_MINUTE=5