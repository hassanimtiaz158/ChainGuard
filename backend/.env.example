# ChainGuard backend configuration.
#
# SAFETY: RPC_URL is an internal service address and is validated on startup to
# point at the bundled local Anvil chain. It is never supplied by API callers.

RPC_URL=http://anvil:8545
EXPECTED_CHAIN_ID=31337

DATABASE_URL=postgresql+psycopg://chainguard:chainguard@localhost:5432/chainguard
REDIS_URL=redis://localhost:6379/0

SCENARIOS_DIR=scenarios
EXPLANATIONS_DIR=explanations
LAB_STATE_DIR=deployments
CONTRACTS_OUT_DIR=../contracts/out

ANALYSIS_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=204800

API_LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]